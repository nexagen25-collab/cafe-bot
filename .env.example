# AI / LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=500

# Pricing - deterministic, not LLM-calculated
TAX_RATE=0.08
DELIVERY_FEE=3.00

# Application
APP_NAME=CafeBot
PORT=3000
NODE_ENV=development

# Data Paths
PROMPTS_DIR=./prompts
DATA_DIR=./data

# Frontend
FRONTEND_URL=http://localhost:3000
